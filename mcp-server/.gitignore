node_modules/
# `dist/index.js` (servidor) e `dist/cli-lib.js` (módulos do CLI) são bundles self-contained
# versionados (plugin via marketplace); o resto de dist/ (saída do tsc, só para testes) fica ignorado.
dist/*
!dist/index.js
!dist/cli-lib.js
# `content/` é versionado (lido em runtime pelo servidor); regenerado por `npm run build`.
*.tgz
