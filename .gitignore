# Artefactos de build
juridico-pt.skill
*.skill
/dist/

# Node
node_modules/
mcp-server/node_modules/

# Servidor MCP: os bundles self-contained `dist/index.js` (servidor) e
# `dist/cli-lib.js` (módulos do CLI) e o conteúdo jurídico em `content/` SÃO
# versionados, para o plugin e o CLI funcionarem quando instalados via
# marketplace (não há `npm install` nesse fluxo). O resto de `dist/` (saída do
# tsc, usada só nos testes) é gerado e fica ignorado.
mcp-server/dist/*
!mcp-server/dist/index.js
!mcp-server/dist/cli-lib.js

# Python
**/__pycache__/
*.py[cod]

# Sistema operativo
.DS_Store
Thumbs.db

# dev-guardian: só a baseline é versionada
**/.guardian/*
!**/.guardian/baseline.json

# Registos de navegação de agentes (Playwright MCP)
.playwright-mcp/

# Claude Code: definições locais de cada máquina (ex.: disabledMcpjsonServers)
.claude/settings.local.json
